# Environment variables example for local development and Netlify Functions
# DO NOT COMMIT real credentials. In production, set them in Netlify:
# Site configuration > Environment variables

# Supabase
SUPABASE_URL=NEEDS_CONFIRMATION
SUPABASE_SERVICE_ROLE_KEY=NEEDS_CONFIRMATION

# Mercado Pago (only the access token and webhook secret are used by the functions)
MERCADOPAGO_ACCESS_TOKEN=NEEDS_CONFIRMATION
MERCADOPAGO_WEBHOOK_SECRET=NEEDS_CONFIRMATION
MERCADOPAGO_PUBLIC_KEY=NEEDS_CONFIRMATION
MERCADOPAGO_CLIENT_ID=NEEDS_CONFIRMATION
MERCADOPAGO_CLIENT_SECRET=NEEDS_CONFIRMATION
# Full public URL of the paymentWebhook function
PAYMENT_WEBHOOK_URL=https://<your-domain>/.netlify/functions/paymentWebhook

# Melhor Envio
MELHOR_ENVIO_TOKEN=NEEDS_CONFIRMATION
# Optional: "sandbox" to use sandbox.melhorenvio.com.br (default: production)
MELHOR_ENVIO_ENV=
# Optional: "App name (technical contact e-mail)" as required by Melhor Envio
MELHOR_ENVIO_USER_AGENT=

# Origin CEP (where shipments originate) - server-side authoritative
ORIGIN_CEP=NEEDS_CONFIRMATION

# Book — price in cents, weight in grams, packaged dimensions in cm
BOOK_TITLE=NEEDS_CONFIRMATION
BOOK_PRICE_CENTS=NEEDS_CONFIRMATION
BOOK_WEIGHT_GRAMS=NEEDS_CONFIRMATION
BOOK_LENGTH_CM=NEEDS_CONFIRMATION
BOOK_WIDTH_CM=NEEDS_CONFIRMATION
BOOK_HEIGHT_CM=NEEDS_CONFIRMATION
# Optional: max copies per order
BOOK_MAX_QUANTITY=

# Optional: pickup at a local address (free shipping). Set PICKUP_ENABLED=false to disable
PICKUP_ENABLED=
PICKUP_ADDRESS=

# Optional: public site URL for Mercado Pago return pages (Netlify sets URL automatically)
SITE_URL=

# Other
NODE_ENV=development
