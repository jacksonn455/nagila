# Environment variables example for local development and Netlify Functions
# DO NOT COMMIT real credentials. In production, set them in Netlify:
# Site configuration > Environment variables

# Supabase
SUPABASE_URL=NEEDS_CONFIRMATION
SUPABASE_SERVICE_ROLE_KEY=NEEDS_CONFIRMATION

# Mercado Pago (only the access token and webhook secret are used by the functions)
MERCADOPAGO_ACCESS_TOKEN=NEEDS_CONFIRMATION
MERCADOPAGO_WEBHOOK_SECRET=NEEDS_CONFIRMATION
MERCADOPAGO_PUBLIC_KEY=NEEDS_CONFIRMATION
MERCADOPAGO_CLIENT_ID=NEEDS_CONFIRMATION
MERCADOPAGO_CLIENT_SECRET=NEEDS_CONFIRMATION
# Full public URL of the paymentWebhook function
PAYMENT_WEBHOOK_URL=https://<your-domain>/.netlify/functions/paymentWebhook

# Melhor Envio
MELHOR_ENVIO_TOKEN=NEEDS_CONFIRMATION
# Optional: "sandbox" to use sandbox.melhorenvio.com.br (default: production)
MELHOR_ENVIO_ENV=
# Optional: "App name (technical contact e-mail)" as required by Melhor Envio
MELHOR_ENVIO_USER_AGENT=

# Origin CEP (where shipments originate) - server-side authoritative
ORIGIN_CEP=NEEDS_CONFIRMATION

# Book — price in cents, weight in grams, packaged dimensions in cm
BOOK_TITLE=NEEDS_CONFIRMATION
BOOK_PRICE_CENTS=NEEDS_CONFIRMATION
BOOK_WEIGHT_GRAMS=NEEDS_CONFIRMATION
BOOK_LENGTH_CM=NEEDS_CONFIRMATION
BOOK_WIDTH_CM=NEEDS_CONFIRMATION
BOOK_HEIGHT_CM=NEEDS_CONFIRMATION
# Optional: max copies per order
BOOK_MAX_QUANTITY=
# Optional: copies in stock (empty = no stock control, 0 = sold out)
BOOK_STOCK=

# Optional: pickup at a local address (free shipping). Set PICKUP_ENABLED=false to disable
PICKUP_ENABLED=
PICKUP_ADDRESS=

# Optional: public site URL for Mercado Pago return pages (Netlify sets URL automatically)
SITE_URL=

# Optional: Discord webhook that gets a message for each approved sale and the Supabase
# monitor alerts (down / back up / monitor error) from the scheduled supabaseHealthCheck function
DISCORD_WEBHOOK_URL=
# Optional: environment name shown in monitor alerts (default: Netlify CONTEXT, then NODE_ENV)
MONITOR_ENVIRONMENT=

# Mercado Livre (official API: OAuth Authorization Code + PKCE, notifications orders_v2/shipments)
# Developer Center: https://developers.mercadolivre.com.br → your application
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# Must be EXACTLY the Redirect URI registered in the application
MERCADO_LIVRE_REDIRECT_URI=https://nagilazortea.com.br/.netlify/functions/mercadoLivreOAuthCallback
# Informational (configured in the application's Notifications settings, not sent per request)
MERCADO_LIVRE_WEBHOOK_URL=https://nagilazortea.com.br/.netlify/functions/mercadoLivreWebhook
# 32 random bytes in base64 (AES-256-GCM key for the stored tokens). Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes the stored tokens unreadable: reconnect the account afterwards.
MERCADO_LIVRE_TOKEN_ENCRYPTION_KEY=
# Optional: separate Discord channel for Mercado Livre sales/alerts (falls back to DISCORD_WEBHOOK_URL)
MERCADO_LIVRE_DISCORD_WEBHOOK_URL=
# Optional: Mercado Livre listings that are the SAME book as the site (shared BOOK_STOCK),
# comma-separated, "MLB123456789" or "MLB123456789:<variation_id>". Empty = separate stock.
MERCADO_LIVRE_BOOK_ITEM_IDS=
# Optional: "true" to trigger the mercadoLivreProcess-background function right after each
# notification (requires Background Functions on the Netlify plan). Otherwise the scheduled
# mercadoLivreScheduler processes the queue every 5 minutes.
MERCADO_LIVRE_BACKGROUND_PROCESSING=

# Other
NODE_ENV=development
